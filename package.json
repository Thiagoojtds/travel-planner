{
  "name": "transfrete-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "tsx server/src/index.ts",
    "client": "vite --host",
    "dev": "concurrently -n \"API,APP\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "tsc -b && vite build && prisma generate",
    "start": "tsx server/src/index.ts",
    "db:push": "prisma db push",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.460.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
